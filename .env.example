# =============================================================================
# ContractIQ — environment variables
# =============================================================================
# Next.js (local):     copy to .env.local and fill in.
# Next.js (Netlify):   Site settings → Environment variables.
# Edge Functions:      supabase secrets set --env-file supabase/functions/.env
#                      (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are
#                      injected automatically into Edge Functions — do not set them there.)
# Vars marked "# SERVER ONLY" must never be prefixed NEXT_PUBLIC_ or sent to the browser.
# =============================================================================

# App
NEXT_PUBLIC_SITE_URL=                  # Public base URL, no trailing slash — http://localhost:3000 locally, Netlify URL / custom domain in prod

# Supabase
NEXT_PUBLIC_SUPABASE_URL=              # Supabase project URL — Dashboard > Project Settings > API (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # Supabase anon / publishable key — Dashboard > Project Settings > API Keys
SUPABASE_SERVICE_ROLE_KEY=             # SERVER ONLY — service role / secret key — Dashboard > Project Settings > API Keys. Used only by tests/scripts (RLS test seeding, evals); never by Next.js runtime code

# OpenAI (Edge Function secrets)
OPENAI_API_KEY=                        # SERVER ONLY — OpenAI API key — platform.openai.com > API keys (project key with no training opt-in)
OPENAI_MODEL=                          # SERVER ONLY — model id for extraction + chat; set to gpt-4o-mini
OPENAI_BASE_URL=                       # SERVER ONLY — optional; leave empty for https://api.openai.com/v1. Set to the mock server URL (http://host.docker.internal:4010/v1) for E2E tests
OPENAI_USER_HASH_SALT=                 # SERVER ONLY — random 32+ char string; salts the SHA-256 user id sent as OpenAI `user` param. Generate: openssl rand -hex 32

# Edge Functions (Edge Function secrets)
ALLOWED_ORIGINS=                       # SERVER ONLY — comma-separated CORS origins allowed to call Edge Functions, e.g. http://localhost:3000,https://contractiq.netlify.app
PROMPT_VERSION=                        # SERVER ONLY — prompt library version folder used by functions; set to v1
CRON_SECRET=                           # SERVER ONLY — random 32+ char string; must equal the Vault secret "cron_secret". Authenticates pg_cron → retention-cleanup / daily-alerts

# Alerts & monitoring (Edge Function secrets)
SLACK_ALERT_WEBHOOK_URL=               # SERVER ONLY — Slack incoming webhook for cost / correction-rate / error-rate alerts — api.slack.com > Your Apps > Incoming Webhooks
MONTHLY_OPENAI_BUDGET_USD=             # SERVER ONLY — monthly OpenAI spend budget in USD (e.g. 400); daily-alerts warns at 80%

# Testing (local / CI only)
E2E_BASE_URL=                          # Base URL Playwright tests run against — http://localhost:3000 locally, Netlify deploy-preview URL in CI
E2E_MAILBOX_URL=                       # Supabase local email inbox (Mailpit) URL used to read verification emails — http://127.0.0.1:54324
